{
  "name": "imagr",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "knip": "bun knip",
    "knip:fix": "bun knip --fix"
  },
  "dependencies": {
    "postcss": "8.5.10",
    "qs": "^6.15.2",
    "shadcn": "^4.8.0",
    "vitest": "^4.1.7"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.9"
}
